+            if (config.filament_map.values.empty()) {
+                layer_extruder_count.insert(0);
+                continue;
+            }
+            const size_t map_idx = std::min<size_t>(filament, config.filament_map.values.size() - 1);
+            int extruder_id = int(config.filament_map.values[map_idx]) - 1;
+            if (extruder_id < 0)
+                extruder_id = 0;
+            layer_extruder_count.insert(extruder_id);
         }
 
