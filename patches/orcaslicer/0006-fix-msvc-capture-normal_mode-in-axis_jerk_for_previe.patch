From bf443aa884bd1d5d9fc31cbb54452bf0e7b60a83 Mon Sep 17 00:00:00 2001
From: wzx <673765578@qq.com>
Date: Sat, 12 Sep 2026 01:29:18 +0800
Subject: [PATCH] fix: capture normal_mode in axis_jerk_for_preview lambda

Upstream 0a3724ed2f's store_move_vertex defines
axis_jerk_for_preview with an explicit capture list that omits the
const local enum normal_mode, relying on non-odr-use exemption
(C++17 [expr.prim.lambda.capture]). MSVC 14.50 rejects the read
without a capture (C3493) and the broken lambda cascades C2064 at
its call sites. Add normal_mode to the capture list; semantics
unchanged.
---
 src/libslic3r/GCode/GCodeProcessor.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libslic3r/GCode/GCodeProcessor.cpp b/src/libslic3r/GCode/GCodeProcessor.cpp
index e4da19cd73..19a432c7a0 100644
--- a/src/libslic3r/GCode/GCodeProcessor.cpp
+++ b/src/libslic3r/GCode/GCodeProcessor.cpp
@@ -7009,7 +7009,7 @@ void GCodeProcessor::store_move_vertex(EMoveType type, EMovePathType path_type,
                                                                     get_acceleration(normal_mode));
     const float junction_deviation = get_option_value(m_time_processor.machine_limits.machine_max_junction_deviation, normal_mode_id);
     const bool use_jd_jerk = (m_flavor == gcfMarlinFirmware && junction_deviation > 0.0f);
-    const auto axis_jerk_for_preview = [this, use_jd_jerk, move_acceleration](Axis axis) {
+    const auto axis_jerk_for_preview = [this, use_jd_jerk, move_acceleration, normal_mode](Axis axis) {
         return use_jd_jerk ? get_axis_max_jerk_with_jd(normal_mode, axis, move_acceleration) : get_axis_max_jerk(normal_mode, axis);
     };
     const float jerk_x = axis_jerk_for_preview(X);
-- 
