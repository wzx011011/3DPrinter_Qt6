From 0f09d67166e6c9a93e2733b81ace04a1ce5d3482 Mon Sep 17 00:00:00 2001
From: wzx <673765578@qq.com>
Date: Sat, 25 Jul 2026 11:23:42 +0800
Subject: [PATCH 02/11] fix(mcut): add missing <chrono> include for
 system_clock

0632bae8's mcut frontend.h uses std::chrono::system_clock::now() but
omits <chrono>. Previous MSVC toolsets transitently included it via
<future>; MSVC 14.50.35717 (VS 2022 17.14+) no longer does, breaking
the build with C2039 'system_clock: not a member of std::chrono'.
---
 src/mcut/include/mcut/internal/frontend.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/mcut/include/mcut/internal/frontend.h b/src/mcut/include/mcut/internal/frontend.h
index ccc2a2babe..1aaffc2c02 100644
--- a/src/mcut/include/mcut/internal/frontend.h
+++ b/src/mcut/include/mcut/internal/frontend.h
@@ -38,6 +38,7 @@
 
 #include "mcut/mcut.h"
 
+#include <chrono>
 #include <future>
 #include <map>
 #include <memory>
-- 
2.32.0.windows.2

