From aa39ac5a4b30f25f757ba12a51f0e0453d510bb1 Mon Sep 17 00:00:00 2001
From: wzx <673765578@qq.com>
Date: Fri, 28 Aug 2026 18:37:10 +0800
Subject: [PATCH 10/11] fix(arrange): seed model instances to physical bed

---
 src/libslic3r/ModelArrange.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/libslic3r/ModelArrange.cpp b/src/libslic3r/ModelArrange.cpp
index 477509e69e..98742c4270 100644
--- a/src/libslic3r/ModelArrange.cpp
+++ b/src/libslic3r/ModelArrange.cpp
@@ -19,6 +19,9 @@ arrangement::ArrangePolygons get_arrange_polys(const Model &model, ModelInstance
     for (ModelObject *mo : model.objects)
         for (ModelInstance *minst : mo->instances) {
             minst->get_arrange_polygon(&ap);
+            // ModelInstance::get_arrange_polygon leaves bed_idx at its
+            // UNARRANGED default; seed it to physical bed 0 before nesting.
+            ap.bed_idx = 0;
             input.emplace_back(ap);
             instances.emplace_back(minst);
         }
