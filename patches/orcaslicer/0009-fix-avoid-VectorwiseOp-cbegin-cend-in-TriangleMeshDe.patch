From 8fbf90838852b9d4d48dee87181edb068d376d95 Mon Sep 17 00:00:00 2001
From: wzx <673765578@qq.com>
Date: Sat, 15 Aug 2026 10:07:18 +0800
Subject: [PATCH 09/11] fix: avoid VectorwiseOp cbegin/cend in TriangleMeshDeal
 (vendored Eigen)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The CI build uses the vendored Eigen headers (src/eigen), whose
VectorwiseOp does not expose cbegin/cend — only newer releases do. Replace
the rowwise() iterator range-assign with explicit index loops that work
against every Eigen version.
---
 src/libslic3r/TriangleMeshDeal.cpp | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/src/libslic3r/TriangleMeshDeal.cpp b/src/libslic3r/TriangleMeshDeal.cpp
index 25e921d3ce..d7c9c99e92 100644
--- a/src/libslic3r/TriangleMeshDeal.cpp
+++ b/src/libslic3r/TriangleMeshDeal.cpp
@@ -38,10 +38,15 @@ TriangleMesh TriangleMeshDeal::smooth_triangle_mesh(const TriangleMesh& mesh, bo
         loop(OV, OF, V, F);
 
         indexed_triangle_set its;
-        auto                 iterv = V.rowwise();
-        auto                 iterf = F.rowwise();
-        its.vertices.assign(iterv.cbegin(), iterv.cend());
-        its.indices.assign(iterf.cbegin(), iterf.cend());
+        // Explicit row loops: the vendored Eigen build lacks VectorwiseOp
+        // cbegin/cend (only present in newer releases), so range-assigning
+        // via rowwise() iterators does not compile everywhere.
+        its.vertices.reserve(V.rows());
+        for (Eigen::Index r = 0; r < V.rows(); ++r)
+            its.vertices.emplace_back(V(r, 0), V(r, 1), V(r, 2));
+        its.indices.reserve(F.rows());
+        for (Eigen::Index r = 0; r < F.rows(); ++r)
+            its.indices.emplace_back(F(r, 0), F(r, 1), F(r, 2));
         TriangleMesh result_mesh(its);
         return result_mesh;
     }
