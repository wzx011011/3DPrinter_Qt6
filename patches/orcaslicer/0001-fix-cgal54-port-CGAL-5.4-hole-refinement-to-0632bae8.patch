From fdcb31781f8d2d5318edff7b56c509b7b00e9da4 Mon Sep 17 00:00:00 2001
From: wzx <673765578@qq.com>
Date: Sat, 25 Jul 2026 11:21:05 +0800
Subject: [PATCH 01/11] fix(cgal54): port CGAL 5.4 hole refinement to 0632bae8
 baseline

Cherry-pick of 4cb3b9ce (fix(260721-jjs): support CGAL 5.4 hole
refinement) onto 0632bae8. The segment() #if 0 -> #if 1 flip applies
cleanly (CGAL 5.4 needs the triangulate_and_refine_hole overload with
explicit output iterators). The standalone CGAL repair() function from
4cb3b9ce is dropped because 0632bae8 moved mesh repair to the admesh-
based TriangleMesh::repair path (no CGAL triangulate_and_refine_hole
call there), so it was both unused and conflicting.
---
 src/libslic3r/MeshBoolean.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/libslic3r/MeshBoolean.cpp b/src/libslic3r/MeshBoolean.cpp
index 779d5a042b..98cac87334 100644
--- a/src/libslic3r/MeshBoolean.cpp
+++ b/src/libslic3r/MeshBoolean.cpp
@@ -336,7 +336,7 @@ void segment(CGALMesh& src, std::vector<CGALMesh>& dst, double smoothing_alpha =
         for (halfedge_descriptor h : border_cycles)
         {
             std::vector<face_descriptor>  patch_facets;
-#if 0
+#if 1 // CGAL 5.4 requires the overload with explicit output iterators.
             std::vector<vertex_descriptor> patch_vertices;
             CGAL::Polygon_mesh_processing::triangulate_and_refine_hole(out, h, std::back_inserter(patch_facets),
                 std::back_inserter(patch_vertices));
