From: OWzx <owzx@local>
Subject: [PATCH 0013] fix(cp-dialect): raise max flush count to 8 (v2.5.0 rebase)

fix(cp-dialect): raise max flush count to 8 (v2.5.0 rebase)
---
diff --git a/src/libslic3r/GCode.cpp b/src/libslic3r/GCode.cpp
index 7e4f5b94..e298d271 100644
--- a/src/libslic3r/GCode.cpp
+++ b/src/libslic3r/GCode.cpp
@@ -207,7 +207,11 @@ std::optional<Vec2d> emitted_xy_after_gcode(const std::string &gcode, const Vec2
 
 static const float g_min_purge_volume = 100.f;
 static const float g_purge_volume_one_time = 135.f;
-static const int g_max_flush_count = 4;
+// owzx-fix (CP-DIALECT): CrealityPrint 5-color+ models reference
+// flush_length_5..8 in change_filament_gcode; the old cap of 4 left those
+// symbols unset and the placeholder parser threw "Not a variable name"
+// (rc=156). 8 covers every CP model tier seen in the wild.
+static const int g_max_flush_count = 8;
 static const size_t g_max_label_object = 64;
 
 // Multi-nozzle printer predicate: an extruder carries a nozzle cluster (extruder_max_nozzle_count
